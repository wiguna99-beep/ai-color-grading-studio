
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#10131c">
<title>AI Color Grading Studio PRO</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#10131c;color:#fff;
 font-family:Arial,sans-serif;padding:18px
}
h1{font-size:25px;color:#a5b4fc;margin-bottom:5px}
.sub{color:#9299aa;font-size:13px}
.card{
 background:#1b2130;padding:16px;
 border:1px solid #30394d;border-radius:15px;
 margin:15px 0
}
h3{font-size:16px;margin:0 0 13px}
.upload{
 display:block;background:#252e42;
 border:1px dashed #65749b;border-radius:12px;
 padding:18px;text-align:center;margin:10px 0;
 color:#c7d2fe
}
input[type=file]{width:100%;font-size:12px;margin-top:10px}
.preview{
 display:grid;grid-template-columns:1fr 1fr;gap:10px
}
.preview img{
 width:100%;aspect-ratio:1/1;object-fit:contain;
 background:#0c1018;border-radius:10px
}
canvas{
 width:100%;height:auto;border-radius:10px;
 background:#0c1018
}
label{display:block;font-size:13px;color:#cbd5e1;margin:15px 0 6px}
input[type=range]{width:100%;accent-color:#818cf8}
button{
 width:100%;padding:14px;border:0;border-radius:10px;
 background:#6366f1;color:white;font-weight:bold;
 font-size:14px;margin-top:10px
}
.secondary{background:#30394d}
.value{float:right;color:#a5b4fc}
.status{font-size:12px;color:#a5b4fc;margin-top:10px}
</style>
</head>

<body>

<h1>AI COLOR GRADING PRO</h1>
<div class="sub">Professional Reference Color Matching Studio</div>

<div class="card">
<h3>01. Foto Utama</h3>
<div class="upload">
Pilih foto yang ingin diedit
<input type="file" id="mainFile" accept="image/*">
</div>
</div>

<div class="card">
<h3>02. Foto Referensi</h3>
<div class="upload">
Pilih foto sebagai acuan warna
<input type="file" id="refFile" accept="image/*">
</div>
</div>

<div class="card">
<h3>03. Preview Foto</h3>
<div class="preview">
<div>
<div class="sub">FOTO ASLI</div>
<img id="originalPreview">
</div>
<div>
<div class="sub">REFERENSI</div>
<img id="referencePreview">
</div>
</div>
</div>

<div class="card">
<h3>04. AI Color Matching</h3>
<canvas id="result"></canvas>
<div class="status" id="status">Menunggu foto...</div>
<button onclick="autoMatch()">AUTO COLOR MATCH</button>
</div>

<div class="card">
<h3>05. Manual Adjustment</h3>

<div id="controls"></div>

<button onclick="applyGrade()">TERAPKAN PENGATURAN</button>
<button class="secondary" onclick="resetGrade()">RESET</button>
</div>

<div class="card">
<h3>06. Export</h3>
<button onclick="downloadImage()">DOWNLOAD HASIL JPG</button>
</div>

<script>
const $ = id => document.getElementById(id);

let mainImage=null;
let refImage=null;
let originalData=null;
let referenceStats=null;

const settings={
 exposure:0,
 contrast:0,
 saturation:0,
 temperature:0,
 shadows:0
};

const controls=[
 ["exposure","Exposure",-100,100],
 ["contrast","Contrast",-100,100],
 ["saturation","Saturation",-100,100],
 ["temperature","Temperature",-100,100],
 ["shadows","Shadows",-100,100]
];

$("controls").innerHTML=controls.map(c=>`
<label>${c[1]} <span class="value" id="${c[0]}Value">0</span></label>
<input type="range" id="${c[0]}" min="${c[2]}" max="${c[3]}" value="0">
`).join("");

controls.forEach(c=>{
 $(c[0]).addEventListener("input",e=>{
 settings[c[0]]=Number(e.target.value);
 $(c[0]+"Value").textContent=e.target.value;
 });
});

function loadImage(file,callback){
 if(!file)return;
 const img=new Image();
 const url=URL.createObjectURL(file);
 img.onload=()=>{
 callback(img);
 URL.revokeObjectURL(url);
 };
 img.src=url;
}

$("mainFile").onchange=e=>{
 loadImage(e.target.files[0],img=>{
 mainImage=img;
 $("originalPreview").src=img.src;
 originalData=getImageData(img);
 $("status").textContent="Foto utama berhasil dimuat.";
 drawOriginal();
 });
};

$("refFile").onchange=e=>{
 loadImage(e.target.files[0],img=>{
 refImage=img;
 $("referencePreview").src=img.src;
 referenceStats=getStats(getImageData(img));
 $("status").textContent="Foto referensi berhasil dimuat.";
 });
};

function getImageData(img){
 const c=document.createElement("canvas");
 const ctx=c.getContext("2d");
 c.width=img.naturalWidth;
 c.height=img.naturalHeight;
 ctx.drawImage(img,0,0);
 return ctx.getImageData(0,0,c.width,c.height);
}

function getStats(data){
 const sums=[0,0,0];
 const squares=[0,0,0];
 const count=data.data.length/4;
 for(let i=0;i<data.data.length;i+=4){
 for(let c=0;c<3;c++){
 const v=data.data[i+c];
 sums[c]+=v;
 squares[c]+=v*v;
 }
 }
 return {
 mean:sums.map(v=>v/count),
 std:squares.map((v,i)=>Math.sqrt(Math.max(0,v/count-(sums[i]/count)**2)))
 };
}

function drawOriginal(){
 if(!originalData)return;
 const canvas=$("result");
 canvas.width=originalData.width;
 canvas.height=originalData.height;
 canvas.getContext("2d").putImageData(originalData,0,0);
}

function autoMatch(){
 if(!mainImage||!refImage){
 alert("Pilih foto utama dan foto referensi terlebih dahulu.");
 return;
 }

 referenceStats=getStats(getImageData(refImage));
 applyGrade(true);
 $("status").textContent=
 "Pencocokan warna otomatis selesai.";
}

function applyGrade(auto=false){
 if(!originalData){
 alert("Pilih foto utama terlebih dahulu.");
 return;
 }

 const canvas=$("result");
 canvas.width=originalData.width;
 canvas.height=originalData.height;

 const ctx=canvas.getContext("2d");
 const output=ctx.createImageData(
 originalData.width,originalData.height
 );

 const source=originalData.data;
 const target=output.data;

 const sourceStats=getStats(originalData);

 const match=auto&&referenceStats;

 const contrast=1+settings.contrast/100;
 const exposure=Math.pow(2,settings.exposure/50);
 const saturation=1+settings.saturation/100;
 const temp=settings.temperature;
 const shadows=settings.shadows;

 for(let i=0;i<source.length;i+=4){
 let rgb=[source[i],source[i+1],source[i+2]];

 if(match){
 rgb=rgb.map((v,c)=>{
 const std=sourceStats.std[c]||1;
 return (v-sourceStats.mean[c])*
 (referenceStats.std[c]/std)+referenceStats.mean[c];
 });
 }

 rgb=rgb.map(v=>(v-128)*contrast+128);
 rgb=rgb.map(v=>v*exposure);

 const gray=rgb[0]*.299+rgb[1]*.587+rgb[2]*.114;

 rgb=rgb.map(v=>gray+(v-gray)*saturation);

 const shadowFactor=1-gray/255;
 rgb[0]+=temp*0.65;
 rgb[1]+=temp*0.08;
 rgb[2]-=temp*0.65;

 rgb=rgb.map(v=>v+shadows*shadowFactor);

 target[i]=Math.max(0,Math.min(255,rgb[0]));
 target[i+1]=Math.max(0,Math.min(255,rgb[1]));
 target[i+2]=Math.max(0,Math.min(255,rgb[2]));
 target[i+3]=source[i+3];
 }

 ctx.putImageData(output,0,0);
 $("status").textContent="Grading berhasil diterapkan.";
}

function resetGrade(){
 controls.forEach(c=>{
 settings[c[0]]=0;
 $(c[0]).value=0;
 $(c[0]+"Value").textContent="0";
 });
 drawOriginal();
 $("status").textContent="Pengaturan direset.";
}

function downloadImage(){
 const canvas=$("result");
 if(!mainImage){
 alert("Belum ada foto untuk diunduh.");
 return;
 }
 const link=document.createElement("a");
 link.download="AI-Color-Grading-PRO.jpg";
 link.href=canvas.toDataURL("image/jpeg",0.95);
 link.click();
}
</script>

</body>
</html>
